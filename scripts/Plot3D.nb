Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox["1", "2"]}], " ", 
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}]], " ", 
  SqrtBox[
   FractionBox["3", 
    RowBox[{"2", " ", "\[Pi]"}]]], " ", 
  RowBox[{"Sin", "[", "\[Theta]", "]"}]}]], "Output",
