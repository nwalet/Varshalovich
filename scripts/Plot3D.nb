Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"u", "[", 
   RowBox[{
   "j_", ",", "m_", ",", "mp_", ",", "\[Omega]_", ",", "\[CapitalTheta]_", ",",
     "\[CapitalPhi]_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"u", "=", 
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{"\[Omega]", "/", "2"}], "]"}], "-", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"m", "+", "mp"}], ">=", "0"}], ",", "\[ImaginaryI]", ",", 
           
           RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], " ", 
         RowBox[{"Sin", "[", 
          RowBox[{"\[Omega]", "/", "2"}], "]"}], 
         RowBox[{"Cos", "[", "\[CapitalTheta]", "]"}]}]}]}], ",", 
      RowBox[{"v", "=", 
       RowBox[{
        RowBox[{"Sin", "[", 
         RowBox[{"\[Omega]", "/", "2"}], "]"}], 
        RowBox[{"Sin", "[", "\[CapitalTheta]", "]"}]}]}], ",", 
      RowBox[{"maxs", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"m", "+", "mp"}], ">=", "0"}], ",", 
         RowBox[{"Min", "[", 
          RowBox[{
           RowBox[{"j", "-", "m"}], ",", 
           RowBox[{"j", "-", "mp"}]}], "]"}], ",", 
         RowBox[{"Min", "[", 
          RowBox[{
           RowBox[{"j", "+", "m"}], ",", 
           RowBox[{"j", "+", "mp"}]}], "]"}]}], "]"}]}]}], "}"}], ",", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "v"}], ")"}], 
      RowBox[{
       RowBox[{"2", "j"}], "-", 
       RowBox[{"Abs", "[", 
        RowBox[{"m", "+", "mp"}], "]"}]}]], 
     SuperscriptBox[
      RowBox[{"(", " ", "u", ")"}], 
      RowBox[{"Abs", "[", 
       RowBox[{"m", "+", "mp"}], "]"}]], 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", 
       RowBox[{"(", 
        RowBox[{"m", "-", "mp"}], ")"}], "\[CapitalPhi]"}], "]"}], " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"j", "+", "m"}], ")"}], "!"}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"j", "-", "m"}], ")"}], "!"}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"j", "+", "mp"}], ")"}], "!"}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"j", "-", "mp"}], ")"}], "!"}]}], "]"}], 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"m", "+", "mp"}], ">=", "0"}], ",", 
          FractionBox["1", 
           RowBox[{
            RowBox[{"s", "!"}], 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"s", "+", 
               RowBox[{"Abs", "[", 
                RowBox[{"m", "+", "mp"}], "]"}]}], ")"}], "!"}], 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"j", "-", "m", "-", "s"}], ")"}], "!"}], 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"j", "-", "mp", "-", "s"}], ")"}], "!"}]}]], ",", 
          FractionBox["1", 
           RowBox[{
            RowBox[{"s", "!"}], 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"s", "+", 
               RowBox[{"Abs", "[", 
                RowBox[{"m", "+", "mp"}], "]"}]}], ")"}], "!"}], 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"j", "+", "m", "-", "s"}], ")"}], "!"}], 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"j", "+", "mp", "-", "s"}], ")"}], "!"}]}]]}], "]"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", 
           SuperscriptBox["v", 
            RowBox[{"-", "2"}]]}], ")"}], "s"]}], ",", 
       RowBox[{"{", 
        RowBox[{"s", ",", "0", ",", "maxs"}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.994740464242342*^9, 3.994740475942791*^9}, {
  3.9947405076201363`*^9, 3.994740707958816*^9}, {3.99474113094942*^9, 
