       RowBox[{"Mesh", "\[Rule]", "None"}]}], "]"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"Boxed", "->", "False"}], ",", 
     RowBox[{"Axes", "->", "False"}], ",", 
     RowBox[{"Frame", "->", "False"}], ",", 
     RowBox[{"Epilog", "->", 
      RowBox[{"{", 
