%======== Helpers for Table 11.7 (Zero Angular Momentum, j=0 cases) ========
%\jzTnode{sign}{leftlab}{ldir}{rightlab}{rdir}{cdir}: a horizontal jm-line
%through a central node (sign +/-) that carries a vertical "$c=0$" stub.
%ldir/rdir: 'i' = arrow points into the node, 'o' = out of the node.
%cdir: 'd' = stub points down, 'u' = up. Used for the 3jm-with-a-zero
%"tee" diagrams of Table 11.7's jm-Symbols rows.
\newcommand{\jzTnode}[6]{%
\begin{tikzpicture}[baseline=0pt,inner sep=0.2em,font=\scriptsize]
\coordinate (N) at (0,0);
\node[dotnode,label={90:\vmk@sign{#1}}] at (N) {};
\if i#3
  \draw[bjmarrown] (-0.75,0) node[left]{$#2$} -- (N);
\else
  \draw[jmarrown] (N) -- (-0.75,0) node[left]{$#2$};
\fi
\if i#5
  \draw[bjmarrown] (0.75,0) node[right]{$#4$} -- (N);
\else
  \draw[jmarrown] (N) -- (0.75,0) node[right]{$#4$};
\fi
\if d#6
  \draw[bjmarrown] (N) -- (0,-0.9) node[below]{$c=0$};
\else 
  \if u#6 
    \draw[jmarrown] (0,-0.9) node[below]{$c=0$} -- (N);
  \else
    \draw (0,-0.9) node[below]{$c=0$} -- (N);
  \fi
\fi
\end{tikzpicture}%
}
%\jzotri{leftlab}{rightlab}{botsign}: a small "downward triangle" open
%diagram -- two top nodes (both +) joined by an unlabelled top edge, each
%running down to a bottom apex node (sign botsign) via edges leftlab
%(left) and rightlab (right). The recurring reduced form paired with a
%detached a-alpha--b-beta line in Table 11.7's jm rows.
\newcommand{\jzotri}[3]{%
\begin{tikzpicture}[baseline=0pt,inner sep=0.2em,font=\scriptsize]
\coordinate (L) at (-0.7,0.5);
\coordinate (R) at (0.7,0.5);
\coordinate (B) at (0,-0.6);
\node[dotnode,label={180:\plusmark}] at (L) {};
\node[dotnode,label={0:\plusmark}] at (R) {};
\node[dotnode,label={-90:\vmk@sign{#3}}] at (B) {};
\draw[jmlinem] (L) -- (R);
\draw[jmlinem] (L) -- (B) node[midway,left]{$#1$};
\draw[jmlinem] (R) -- (B) node[midway,right]{$#2$};
\end{tikzpicture}%
}
%\jzld{extdir}{intdir}{leftlab}{rightlab}{botsign}: the reduced form used on the
%right of Table 11.7's jm rows -- a detached horizontal a-alpha--b-beta
%line (
%extdir 'o' = arrows out to the labels, 'i' = arrows in drawn above
%a closed \jzotri{leftlab}{rightlab}{botsign} normalization triangle.
\newcommand{\jzld}[5]{%
\pgfmathsetmacro{\Len}{0.8}
\pgfmathsetmacro{\HEO}{0}
\pgfmathsetmacro{\HET}{-0.6}
\pgfmathsetmacro{\Sz}{0.7}
\begin{tikzpicture}[baseline=0pt,inner sep=0.13em,font=\scriptsize]
\if n#2 % not a metric tensor
\if o#1
  \draw[bjmarrown] (-\Len,\HEO) -- (0,\HEO)  node[above]{$a\alpha$};
  \draw[jmarrown] (0,\HEO) node[above]{$b\beta$} -- (\Len,\HEO) ;
\else
  \draw[jmarrown] (0,\HEO) --(-\Len,\HEO)   node[above]{$a\alpha$};
  \draw[bjmarrown] (\Len,\HEO) node[above]{$b\beta$}--(0,\HEO) ; 
\fi
\else
\if o#1
  \draw[jmarrown] (0,\HEO) -- (-\Len,\HEO) node[above]{$a\alpha$};
  \draw[jmarrown] (0,\HEO) -- (\Len,\HEO) node[above]{$b\beta$};
\else
  \draw[bjmarrown] (-\Len,\HEO) node[above]{$a\alpha$} -- (0,\HEO);
  \draw[bjmarrown] (\Len,\HEO) node[above]{$b\beta$} -- (0,\HEO);
\fi
\if l#2
  \draw[jmlinem] (\Len,\HEO) -- (-\Len,\HEO);
\else \if r#2
  \draw[jmlinem] (-\Len,\HEO) -- (\Len,\HEO);
\fi
\fi
\fi
  \coordinate (L) at ($\Sz*(-0.861,0.5)+(0,\HET)$);
  \coordinate (R) at ($\Sz*(0.861,0.5)+(0,\HET)$);
  \coordinate (B) at ($\Sz*(0,-1)+(0,\HET)$);
\node[dotnode,label={180:\plusmark}] at (L) {};
\node[dotnode,label={0:\plusmark}] at (R) {};
\node[dotnode,label={-90:\vmk@sign{#5}}] at (B) {};
\draw[jmlinem] (L) -- (R);
\draw[jmlinem] (L) -- (B) node[midway,left]{$#3$};
\draw[jmlinem] (R) -- (B) node[midway,right]{$#4$};
\end{tikzpicture}%
}

