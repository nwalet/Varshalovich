%\opline{left label}{right label}{line label}: two operator boxes joined
%by a single labelled jm-line
\newcommand{\opline}[3]{%
\begin{tikzpicture}[baseline=0pt]
\node[opbox] (M) at (0,0) {$#1$};
\node[opbox] (N) at (2.2,0) {$#2$};
\draw[jmline] (M) -- (N) node[midway,above]{$#3$};
\end{tikzpicture}%
}


%\sixjdiagramd{a,b,c,A,B,C,sc}: the full closed-loop
%"downward triangle with a center point" diagram for a 6j symbol {a b c \\ A B C},
% nodes are connected in the order 1-a->2-b->3-c->1, 1-B->M; 2-C->M; 3-A->M,
% and the three node signs + are placed at the three vertices of the triangle.
%Comma-separated \newlistcommand/\argx calling convention, like \twIdiaga;
%edges use \normedge for upright, normal-offset labels instead of "sloped".
\newlistcommand{\sixjdiagramd}{%
{\begin{tikzpicture}[baseline=0pt, inner sep=0.1em,font=\scriptsize]
\coordinate (B) at ($0.8*(0,-1)$);
\coordinate (L) at ($0.8*(-0.866,0.5)$);
\coordinate (R) at ($0.8*(0.866,0.5)$);
\coordinate (M) at (0,0);
\node[dotnode,label={below:\plusmark}] at (B) {};
\node[dotnode,label={above left:\plusmark}] at (L) {};
\node[dotnode,label={above right:\plusmark}] at (R) {};
\node[dotnode,label={above:$\argx{7}$}] at (M) {};
\normedge{B}{R}{0.5}{-0.15}{$\argx{4}$} % A
\normedge{R}{L}{0.5}{-0.2}{$\argx{5}$} % B
\normedge{L}{B}{0.5}{-0.2}{$\argx{6}$} % C
\normedge{M}{L}{0.4}{0.14}{$\argx{1}$} % a
\normedge{M}{B}{0.4}{-0.15}{$\argx{2}$}  % b
\normedge{M}{R}{0.4}{-0.15}{$\argx{3}$} % c
\end{tikzpicture}}
}
%\sixjdiagramu{A,B,C,a,b,c,centersign}: outer triangle (vertices all
%"+") with edges A,B,C, and an inner node (sign centersign) connected to
%each vertex by a,b,c -- the recurring 9j-symbol "triangle with inner
%node" diagram. Comma-separated calling convention, like \twIdiaga.
\newlistcommand{\sixjdiagramu}{%
{\begin{tikzpicture}[baseline=0pt, inner sep=0.2em,font=\scriptsize]
\coordinate (T) at ($0.8*(0,1)$);
\coordinate (L) at ($0.8*(-0.866,-0.5)$);
\coordinate (R) at ($0.8*(0.866,-0.5)$);
\coordinate (M) at (0,0);
\node[dotnode,label={above:\plusmark}] at (T) {};
\node[dotnode,label={below:\plusmark}] at (L) {};
\node[dotnode,label={below:\plusmark}] at (R) {};
\node[dotnode,label={right:$\argx{7}$}] at (M) {};
\normedge{T}{L}{0.5}{-0.15}{$\argx{1}$} % A
\normedge{R}{T}{0.5}{-0.15}{$\argx{2}$} % B
\normedge{L}{R}{0.5}{-0.15}{$\argx{3}$} %C
\normedge{M}{T}{0.5}{-0.15}{$\argx{6}$} % c
\normedge{M}{L}{0.5}{0.15}{$\argx{4}$} % a
\normedge{R}{M}{0.5}{0.15}{$\argx{5}$} % b
\end{tikzpicture}}
}

%\sixjdsq{A,B,C,a,b,c,centersign}: square representation of the 6j-symbol
