\normedge[jmlinem=0.5]{h2}{h3}{0.5}{0.2}{$#7$}; %b'
\normedge[jmlinem=0.5]{h4}{h3}{0.5}{-0.2}{$#6$}; %d
\normedge[jmlinem=0.5]{h4}{h5}{0.5}{-0.2}{$#8$}; %e'
\normedge[jmlinem=0.5]{h5}{h0}{0.5}{-0.2}{$#5$}; %e
\normedge[jmlinem=0.25]{h4}{h1}{0.75}{0.2}{$#3$}; %c
\normedge[jmlinem=0.25]{h3}{h0}{0.75}{-0.2}{$#4$}; %f
\end{tikzpicture}}

%---- Table 11.8 helpers (Zero Rotation, R=1 / R^{-1}R=1 cases) ----
%A "bra line": double arrowhead near the start + single at the end.
\tikzset{vmkbra/.style={postaction={decorate,decoration={markings,
  mark=at position 0.12 with {\arrow{Stealth[length=1.6mm] Stealth[length=1.6mm]}},
  mark=at position 0.995 with {\arrow{Stealth[length=1.9mm]}}}}}}
%\rstubline{type}{left}{right}{sign}: bra-line left--node(sign)--right with a
%vertical double-dashed "$R=1$" stub down to a delta node. type 'o'=dashed
%Omega-line, else solid j-line.
\newcommand{\rstubline}[4]{%
\begin{tikzpicture}[baseline=0pt,inner sep=0.13em,font=\scriptsize]
\if o#1
  \tikzset{vmkln/.style={thick,dashed}}
\else
  \tikzset{vmkln/.style={thick}}
\fi
\draw[vmkln,vmkbra] (-0.8,0) node[left]{$#2$} -- (0.8,0) node[right]{$#3$};
\node[dotnode,label={90:\vmk@sign{#4}}]at(0,0){};
\draw[rline] (0,0) -- (0,-0.75);
%\node[deltanode] at (0,-0.75){};
\node[below,inner sep=1pt] at (0,-0.86){$R{=}1$};
\end{tikzpicture}}
%\rredline{type}{left}{right}: the reduced plain bra-line.
\newcommand{\rredline}[3]{%
\begin{tikzpicture}[baseline=0pt,inner sep=0.13em,font=\scriptsize]
\if o#1
  \tikzset{vmkln/.style={thick,dashed}}
\else
  \tikzset{vmkln/.style={thick}}
  \fi
\draw[vmkln,vmkbra] (-0.5,0) node[above]{$#2$} -- (0.5,0) node[above]{$#3$};
\end{tikzpicture}}
%\rarcline{type}{left}{right}{sign}: bra-line with an inverted-V double-dashed
%"$R^{-1}$/$R$" arc between two nodes (the R^{-1}R=1 case).
\newcommand{\rarcline}[4]{%
\begin{tikzpicture}[baseline=0pt,inner sep=0.13em,font=\scriptsize]
\if o#1
\tikzset{vmkln/.style={thick,dashed}}
\else
\tikzset{vmkln/.style={thick}}
\fi
\draw[vmkln,vmkbra] (-1.22,0) node[left]{$#2$} -- (1.2,0) node[right]{$#3$};
