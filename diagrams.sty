%a,b,c, and the outer edges labelled A,B,C. Comma-separated calling
%convention, like \twIdiaga. (centersign/#7 is accepted but unused, same as
%before -- this diagram doesn't actually draw a center node/edges.)
\newlistcommand{\sixjdsq}{%
{\begin{tikzpicture}[baseline=0pt, inner sep=0.2em,font=\scriptsize]
\coordinate (T) at ($0.7*(0,1)$);
\coordinate (L) at ($0.7*(-1,0)$);
\coordinate (R) at ($0.7*(1,0)$);
\coordinate (B) at ($0.7*(0,-1)$);
\node[dotnode,label={above:\plusmark}] at (T) {};
\node[dotnode,label={left:\minusmark}] at (L) {};
\node[dotnode,label={right:\minusmark}] at (R) {};
\node[dotnode,label={below:\plusmark}] at (B) {};
\normedge{T}{L}{0.5}{-0.15}{$\argx{1}$} % A
\normedge[jmlinem=0.75]{T}{B}{0.75}{0.15}{$\argx{2}$} % B
\normedge{T}{R}{0.5}{0.2}{$\argx{3}$} % C
\normedge{L}{B}{0.5}{-0.15}{$\argx{6}$} % c
\normedge{B}{R}{0.5}{-0.15}{$\argx{4}$} % a
\normedge[jmlinem=0.75]{R}{L}{0.75}{0.15}{$\argx{5}$} % b
\end{tikzpicture}}
}

