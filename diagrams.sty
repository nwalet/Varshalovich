\node[dotnode,label={90:\vmk@sign{#4}}]at(0.4,0){};
\coordinate (D) at (0,-0.6);%\node[deltanode] at (D){};
\draw[rline] (-0.4,0) -- (D);\draw[rline] (D) -- (0.4,0);
\draw[rline] (D) -- (0,-1);
\node[inner sep=1pt] at (-0.52,-0.4){$R^{-1}$};
\node[inner sep=1pt] at (0.44,-0.4){$R$};
