%Character-splitting helpers for the sign/direction string arguments of
%\sixjdgen and \ninejdgen below: each takes a fixed-length string of
%single characters (already fully expanded via \edef) delimited by \relax
%and stores the characters in one macro each. Comparisons against these
%use \if (character-code comparison), not \ifx, so the catcode-12
%characters produced by \edef compare equal to normal input characters.
\def\vmk@splitfour#1#2#3#4\relax{\def\vmk@sA{#1}\def\vmk@sB{#2}\def\vmk@sC{#3}\def\vmk@sD{#4}}
\def\vmk@splitsix#1#2#3#4#5#6\relax{\def\vmk@dA{#1}\def\vmk@dB{#2}\def\vmk@dC{#3}\def\vmk@dD{#4}\def\vmk@dE{#5}\def\vmk@dF{#6}}
\def\vmk@splitninesigns#1#2#3#4#5#6\relax{\def\vmk@nsA{#1}\def\vmk@nsB{#2}\def\vmk@nsC{#3}\def\vmk@nsD{#4}\def\vmk@nsE{#5}\def\vmk@nsF{#6}}
\def\vmk@splitnine#1#2#3#4#5#6#7#8#9\relax{\def\vmk@nA{#1}\def\vmk@nB{#2}\def\vmk@nC{#3}\def\vmk@nD{#4}\def\vmk@nE{#5}\def\vmk@nF{#6}\def\vmk@nG{#7}\def\vmk@nH{#8}\def\vmk@nI{#9}}
%\vmk@sign{<char macro>}: renders + as \plusmark, anything else as \minusmark
\def\vmk@sign#1{\if+#1\plusmark\else\minusmark\fi}
% -- helpers (no @ so they work in this standalone document) --
% sign glyph for a '+'/'-' character
\def\vmksign#1{\if+#1\plusmark\else\minusmark\fi}
% \esplit{<target cs>}{<expandable text>}: expand the text, then split it
% into a comma list with \makeclist.  Needed because \makeclist tokenises
% its argument literally, so \argx{n} has to be expanded first.
\newcommand{\esplit}[2]{%
  \edef\sl@e{#2}%
  \expandafter\makeclist\expandafter[\expandafter#1\expandafter]\expandafter{\sl@e}}
% \ifdir{<k>}{<forward>}{<reverse>}: run <forward> if direction char k is 'd'
\newcommand{\ifdir}[3]{\if\csname dir#1\endcsname d#2\else#3\fi}
%\sixjdgen{l,r,b,ll,lr,v,SIGNS,DIRS}: fully general form of the Table 11.6
%"upward triangle with center node" 6j diagram. Items 1-6 are the edge
%labels by slot: 1 = left side (T-L), 2 = right side (T-R), 3 = bottom
%(L-R), 4 = lower-left spoke (L-M), 5 = lower-right spoke (M-R), 6 =
%vertical spoke (M-T); the basis diagram of {a b c; A B C} is
%\sixjdgen{B,A,C,a,b,c,++++,dddddd}, i.e. the same comma order as
%\sixjdiagramu. Item 7 = four sign characters for the T,L,R,M nodes.
%Item 8 = six direction characters (slot order as items 1-6): "d" is the
%book's standard direction (left: L->T, right: T->R, bottom: L->R,
%lower-left: L->M, lower-right: M->R, vertical: M->T), "r" reverses that
%edge (arrowhead flipped in place; the label stays on the same side).
%Unlike \sixjdiagramu (kept unchanged for its validated pre-Table-11.5
%call sites), this macro matches the direction conventions of the
%Table 11.6 originals (orig pp. 438).
\newlistcommand{\sixjdgen}{%
{\begin{tikzpicture}[baseline=0pt, inner sep=0.2em,font=\scriptsize]
   \foreach \i in {0,...,2}{\coordinate (n\i) at (90+120*\i:0.8);}%
\coordinate (n3) at (0,0);
  % split the sign string (arg 10) and direction string (arg 11)
  \esplit{\signlst}{\argx{7}}%
  \esplit{\direcs}{\argx{8}}%
    \foreach \s [count=\i from 0] in \signlst {%
    \if3\i
    \node[dotnode,label={270:\vmksign{\s}}] at (n\i) {};
    \else
    \node[dotnode,label={90+120*\i:\vmksign{\s}}] at (n\i) {};
    \fi
  }%
   % stash each direction character in \dir0..\dir8 for per-slot testing.
  % \global because \foreach runs its body in a group.
  \foreach \d [count=\k from 0] in \direcs {%
    \global\expandafter\let\csname dir\k\endcsname\d}%
\ifdir0{\normedge{n1}{n0}{0.5}{0.22}{$\argx{1}$}}{\normedge{n0}{n1}{0.5}{-0.22}{$\argx{1}$}}
\ifdir1{\normedge{n0}{n2}{0.5}{0.22}{$\argx{2}$}}{\normedge{n2}{n0}{0.5}{-0.22}{$\argx{2}$}}
\ifdir2{\normedge{n1}{n2}{0.5}{-0.22}{$\argx{3}$}}{\normedge{n2}{n1}{0.5}{0.22}{$\argx{3}$}}
\ifdir3{\normedge{n1}{n3}{0.6}{0.14}{$\argx{4}$}}{\normedge{n3}{n1}{0.4}{-0.14}{$\argx{4}$}}
\ifdir4{\normedge{n3}{n2}{0.3}{0.14}{$\argx{5}$}}{\normedge{n2}{n3}{0.7}{-0.14}{$\argx{5}$}}
\ifdir5{\normedge{n3}{n0}{0.3}{0.13}{$\argx{6}$}}{\normedge{n0}{n3}{0.7}{-0.13}{$\argx{6}$}}
\end{tikzpicture}}
}
%\ninejdgen{s1,...,s9,SIGNS,DIRS}: fully general form of the 
%9j hexagon. Items 1-9 are the labels by structural slot (named after
%where the standard basis diagram of {a1 a2 a3; c1 c2 c3; b1 b2 b3} puts
%its own labels):
% 1 = upper-left edge (n0-n1), "a1", 
% 2 = vertical diameter (n0-n3), "a2",
% 3 = top right edge (n0-n5), "a3"
% 4 = left side (n2-n1), "b1"
% 5 = lower left edge (n2-n3), "b2"
% 6 = oblique diameter (n2-n5), "b3"
% 7 = oblique diameter (n4-n1), "c1"
% 8 = lower right (n4-n3), "c2"
% 9 = right (n4-n5), "c3"
% 10 six sign characters for the nodes n0-n5 (standard pattern "+-+-+-"). 
% Item 11 = nine direction characters for the (see 1-9)(slot order): 
% "d" = the book's standard direction as specified above
% "r" = reversed in place. 
% The basis is \ninejdgen{a_1,a_2,a_3,b_1,b_2,b_3,c_1,c_2,c_3,+-+-+-,ddddddddd}.
%(\ninejd, kept unchanged, draws the differently-labelled Table 11.2
